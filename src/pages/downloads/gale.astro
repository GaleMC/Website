---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.svelte";
import Footer from "@/components/Footer.svelte";
import GradientBackground from "@/components/ui/GradientBackground.svelte";
import ProductDownloadHeader from "@/components/ProductDownloadHeader.svelte";

const REPO = "GaleMC/Gale";

async function fetchReleases() {
  try {
    const headers: Record<string, string> = {
      Accept: "application/vnd.github.v3+json",
      "User-Agent": "GaleMC-Website",
    };
    const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
    if (token) headers.Authorization = `token ${token}`;
    const res = await fetch(
      `https://api.github.com/repos/${REPO}/releases?per_page=20`,
      { headers }
    );
    if (!res.ok) return [];
    const data = await res.json();
    return data
      .filter((r: any) => !r.draft && !r.prerelease)
      .map((r: any) => {
        const jarAsset = r.assets?.find((a: any) => a.name?.endsWith(".jar")) ?? null;
        return {
          id: r.id,
          name: r.name,
          publishedAt: r.published_at,
          htmlUrl: r.html_url,
          jarDownloadUrl: jarAsset?.browser_download_url ?? null,
          jarSize: jarAsset?.size ?? null,
        };
      });
  } catch {
    return [];
  }
}

const releases = await fetchReleases();

function formatSize(bytes: number | null) {
  if (!bytes) return "";
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function formatDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", {
    day: "2-digit", month: "2-digit", year: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}
---

<Layout>
  <Navbar slot="navbar" client:load />
  <GradientBackground client:load />

  <main class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
    <ProductDownloadHeader
      client:load
      titleKey="downloads.products.gale.title"
      descriptionKey="downloads.products.gale.description"
      downloadHref="/api/v2/latest"
      sourceHref="https://github.com/GaleMC/Gale"
      gradientPattern={`repeating-linear-gradient(
        90deg, #3b82f6 0%, #60a5fa 15%, #93c5fd 30%,
        #60a5fa 45%, #3b82f6 60%, #2563eb 75%,
        #3b82f6 90%, #60a5fa 100%
      )`}
    />

    <section class="mt-12 sm:mt-16 relative mb-20">
      <div class="rounded-lg p-4 sm:p-6" style="border: 1px solid var(--border); background: var(--card);">
        {
          releases.length === 0 ? (
            <p class="text-neutral-300 text-center py-12">No releases available.</p>
          ) : (
            <div class="space-y-2">
              {releases.map((release, index) => (
                <div
                  class="group flex items-center gap-4 px-4 py-3 rounded-lg transition-all hover:bg-white/5"
                  style="border: 1px solid transparent"
                >
                  <div class="flex items-center gap-3 min-w-0 flex-1">
                    {index === 0 && (
                      <span class="inline-flex items-center rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-medium px-2 py-0.5 shrink-0">Latest</span>
                    )}
                    <svg class="size-4 text-neutral-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                    <span class="text-sm text-neutral-200 font-medium">{release.name}</span>
                  </div>
                  <div class="hidden sm:block text-xs text-neutral-500 shrink-0">{formatDate(release.publishedAt)}</div>
                  <div class="text-xs text-neutral-500 shrink-0">{formatSize(release.jarSize)}</div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <a href={release.htmlUrl} target="_blank" rel="noopener noreferrer" class="p-1.5 rounded text-neutral-500 hover:text-neutral-300 transition-colors" title="View on GitHub">
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    {release.jarDownloadUrl && (
                      <a href={release.jarDownloadUrl} class="p-1.5 rounded text-neutral-400 hover:text-blue-300 transition-colors" title="Download JAR">
                        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )
        }
        <div class="mt-6 text-center">
          <a href="https://github.com/GaleMC/Gale/releases" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 hover:text-neutral-300 transition-colors">
            View all releases on GitHub &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" client:load />
</Layout>
