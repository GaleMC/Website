---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.svelte";
import Footer from "@/components/Footer.svelte";
import GradientBackground from "@/components/ui/GradientBackground.svelte";
import ProductDownloadHeader from "@/components/ProductDownloadHeader.svelte";

const REPO = "GaleMC/Gale";
const WORKFLOW_ID = 43796647;

function authHeaders() {
  const headers: Record<string, string> = {
    Accept: "application/vnd.github.v3+json",
    "User-Agent": "GaleMC-Website",
  };
  const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
  if (token) headers.Authorization = `Bearer ${token}`;
  return headers;
}

async function fetchBuilds() {
  try {
    const runsRes = await fetch(
      `https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW_ID}/runs?per_page=30&status=success`,
      { headers: authHeaders() }
    );
    if (!runsRes.ok) return [];
    const runsData = await runsRes.json();
    const runs = (runsData.workflow_runs || []).filter(
      (r: any) => r.head_branch === "master" || r.head_branch === "main"
    );
    return runs.map((run: any) => ({
      id: run.id,
      runNumber: run.run_number,
      commitId:
        run.head_commit?.id?.substring(0, 7) || run.head_sha?.substring(0, 7),
      commitMessage:
        run.head_commit?.message?.split("\n")[0] || run.display_title || "",
      branch: run.head_branch,
      createdAt: run.created_at,
      htmlUrl: run.html_url,
    }));
  } catch {
    return [];
  }
}

const builds = await fetchBuilds();

function formatDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<Layout>
  <Navbar slot="navbar" client:load />
  <GradientBackground client:load />

  <main class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
    <ProductDownloadHeader
      client:load
      titleKey="downloads.products.gale.title"
      descriptionKey="downloads.products.gale.description"
      downloadHref="/api/v2/latest"
      sourceHref="https://github.com/GaleMC/Gale"
      gradientPattern={`repeating-linear-gradient(
        90deg, #3b82f6 0%, #60a5fa 15%, #93c5fd 30%,
        #60a5fa 45%, #3b82f6 60%, #2563eb 75%,
        #3b82f6 90%, #60a5fa 100%
      )`}
    />

    <section class="mt-12 sm:mt-16 relative mb-20">
      <div
        class="rounded-lg p-4 sm:p-6"
        style="border: 1px solid var(--border); background: var(--card);"
      >
        {
          builds.length === 0 ? (
            <p class="text-neutral-300 text-center py-12">
              No builds available.
            </p>
          ) : (
            <>
              <div class="space-y-2">
                {builds.map((build, i) => (
                  <div
                    class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-white/5 transition-colors"
                    style={
                      i === 0
                        ? "border: 1px solid rgba(59,130,246,0.15);"
                        : "border: 1px solid transparent;"
                    }
                  >
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      {i === 0 && (
                        <span class="inline-flex items-center rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-medium px-2 py-0.5 shrink-0">
                          Latest
                        </span>
                      )}
                      <svg
                        class="size-4 text-neutral-500 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                        />
                      </svg>
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-mono text-sm text-neutral-200 font-medium">
                            #{build.runNumber}
                          </span>
                          {build.commitId && (
                            <span class="font-mono text-xs text-neutral-500">
                              ({build.commitId})
                            </span>
                          )}
                        </div>
                        {build.commitMessage && (
                          <p class="text-xs text-neutral-400 truncate max-w-md mt-0.5">
                            {build.commitMessage}
                          </p>
                        )}
                      </div>
                    </div>
                    <div class="hidden sm:block text-xs text-neutral-500 shrink-0">
                      {formatDate(build.createdAt)}
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <a
                        href={build.htmlUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="p-1.5 rounded text-neutral-500 hover:text-neutral-300 transition-colors"
                        title="View on GitHub Actions"
                      >
                        <svg
                          class="size-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                      </a>
                      <a
                        href={`/api/v2/download/artifact?run_id=${build.id}`}
                        class="p-1.5 rounded text-neutral-400 hover:text-blue-300 transition-colors"
                        title="Download artifact"
                      >
                        <svg
                          class="size-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
              <div class="mt-6 text-center">
                <a
                  href="https://github.com/GaleMC/Gale/actions"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-neutral-500 hover:text-neutral-300 transition-colors"
                >
                  View all builds on GitHub Actions &rarr;
                </a>
              </div>
            </>
          )
        }
      </div>
    </section>
  </main>

  <Footer slot="footer" client:load />
</Layout>
